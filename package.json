{
  "name": "use-navi-date",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/front-end",
    "apps/back-end",
    "packages/*"
  ],
  "scripts": {
    "dev:front": "cd apps/front-end && npm run dev",
    "dev:back": "cd apps/back-end && npm run start:dev",
    "dev:shared": "cd packages/shared && npm run dev",
    "dev": "concurrently \"npm run dev:shared\" \"npm run dev:back\" \"npm run dev:front\"",
    "build:front": "cd apps/front-end && npm run build",
    "build:back": "cd apps/back-end && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    "build:nest": "cd apps/back-end && npm run build",
    "start:front": "cd apps/front-end && npm start",
    "start:back": "cd apps/back-end && npm run start",
    "start:nest": "cd apps/back-end && npm run start:prod",
    "dev:backend": "cd apps/back-end && npm run start:dev",
    "dev:frontend": "cd apps/front-end && npm run dev",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up -d --build",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml up -d --build",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f",
    "install:all": "npm install && cd apps/front-end && npm install && cd ../../apps/back-end && npm install && cd ../../packages/shared && npm install",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^6.0.0",
    "jwt-decode": "^4.0.0"
  }
}
